{
    "name": "infrangible/m2-catalog-attribute-set-filter",
    "description": "Adds an \"Attribute Set\" filter to layered navigation, so shoppers can narrow category and search results by product type as defined by your attribute sets.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Layered navigation",
        "Catalog",
        "attribute set filter",
        "filter by product type in layered navigation"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-attribute-set-filter",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogAttributeSetFilter\\": "src"
        }
    }
}
